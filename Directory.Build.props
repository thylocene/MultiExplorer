<Project>
  <PropertyGroup>
    <!-- Shared by the application and installer so their displayed versions cannot drift. -->
    <Version>1.8.1</Version>

    <!--
      Release publishes are self-contained, so they do not receive security fixes
      from the machine-wide .NET installation. Keep the runtime servicing version
      explicit and shared by both executable projects.
    -->
    <SelfContainedRuntimeVersion>8.0.31</SelfContainedRuntimeVersion>
  </PropertyGroup>
</Project>
