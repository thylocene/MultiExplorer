<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MultiExplorer</AssemblyName>
    <RootNamespace>MultiExplorer</RootNamespace>
    <ApplicationIcon>file-explorer.ico</ApplicationIcon>
    <!-- PerMonitorV2 matches Windows Explorer's own DPI awareness context.
         Using SystemAware causes the embedded Explorer content to be rendered
         at the wrong scale because the two processes' DPI contexts don't agree. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

    <!-- Publish produces a single self-contained .exe — no runtimeconfig.json or deps.json needed.
         Run: dotnet publish -c Release
         Output: bin\Release\net8.0-windows\win-x64\publish\MultiExplorer.exe (standalone) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="file-explorer.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MultiExplorer.Tests\**" />
    <EmbeddedResource Remove="MultiExplorer.Tests\**" />
    <None Remove="MultiExplorer.Tests\**" />
  </ItemGroup>

</Project>
