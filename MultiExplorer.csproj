<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MultiExplorer</AssemblyName>
    <RootNamespace>MultiExplorer</RootNamespace>
    <ApplicationIcon>MultiExplorer-Installer.ico</ApplicationIcon>
    <!-- PerMonitorV2 matches Windows Explorer's own DPI awareness context.
         Using SystemAware causes the embedded Explorer content to be rendered
         at the wrong scale because the two processes' DPI contexts don't agree. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

    <!-- Publish produces a self-contained app — no separate .NET runtime is needed.
         Keep the runtime as separate files so Windows does not have to scan one
         160+ MB executable before a newly installed copy can start.
         Run: dotnet publish -c Release
         Output: bin\Release\net8.0-windows\win-x64\publish\ -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Precompile managed assemblies so a newly installed copy does not have to
         JIT most of WinForms and the application before displaying its window. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- MultiExplorer ships in English only. Do not copy the Windows Desktop
         runtime's localized satellite-resource assemblies into publish output. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="MultiExplorer-Installer.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MultiExplorer.Tests\**" />
    <Compile Remove="MultiExplorer.OperationHost\**" />
    <EmbeddedResource Remove="MultiExplorer.Tests\**" />
    <EmbeddedResource Remove="MultiExplorer.OperationHost\**" />
    <None Remove="MultiExplorer.Tests\**" />
    <None Remove="MultiExplorer.OperationHost\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="MultiExplorer.OperationHost\MultiExplorer.OperationHost.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="MultiExplorer-Installer.ico" />
    <None Update="release_notes.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyOperationHostForBuild" AfterTargets="Build">
    <ItemGroup>
      <_OperationHostFiles Include="$(MSBuildProjectDirectory)\MultiExplorer.OperationHost\bin\$(Configuration)\net8.0-windows\win-x64\MultiExplorer.OperationHost.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OperationHostFiles)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishOperationHost" AfterTargets="Publish">
    <PropertyGroup>
      <_OperationHostPublishDir Condition="$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$(PublishDir)</_OperationHostPublishDir>
      <_OperationHostPublishDir Condition="!$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$(MSBuildProjectDirectory)\$(PublishDir)</_OperationHostPublishDir>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildProjectDirectory)\MultiExplorer.OperationHost\MultiExplorer.OperationHost.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(_OperationHostPublishDir);Version=$(Version)" />
  </Target>
</Project>
