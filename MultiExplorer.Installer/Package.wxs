<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="MultiExplorer"
           Manufacturer="MultiExplorer"
           Version="$(var.Version)"
           Scope="perUser"
           UpgradeCode="{C1965219-E757-47A2-AA69-F84F693B94DC}">

    <SummaryInformation Description="MultiExplorer dual-pane file explorer" />

    <!-- Expose the build date as MSI metadata as well as showing it in the UI. -->
    <Property Id="BUILD_DATE" Value="$(var.BuildDate)" />

    <!--
      AllowSameVersionUpgrades: removes any existing installation of the same version
      before installing fresh, so repeated builds with the same version number always
      deploy the latest exe.  AllowDowngrades remains no (default), so installing an
      older version still shows the DowngradeErrorMessage.
      Schedule afterInstallExecute: the CloseApplication actions run while the old
      product is still registered, then Windows Installer replaces it transactionally
      after the new files have been installed.
    -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallExecute"
      DowngradeErrorMessage="A newer version of MultiExplorer is already installed." />

    <!--
      MultiExplorer can intentionally remain alive in the notification area when
      its window is closed, so terminate every instance before files are changed.
      Use WiX's in-process native custom action: launching powershell.exe here creates
      a console window, and same-version upgrades can run that action once for the
      incoming MSI and again while uninstalling the previous MSI.
    -->
    <util:CloseApplication Id="CloseMultiExplorer"
                           Target="MultiExplorer.exe"
                           CloseMessage="no"
                           EndSessionMessage="no"
                           ElevatedCloseMessage="no"
                           ElevatedEndSessionMessage="no"
                           Timeout="1"
                           TerminateProcess="0"
                           RebootPrompt="no" />

    <!--
      Read the install path persisted by the MainExe component's registry KeyPath.
      util:RemoveFolderEx needs a populated property during uninstall; directory
      properties such as INSTALLFOLDER may not be re-evaluated in the uninstall
      sequence, so we retrieve the value from the registry instead.
    -->
    <Property Id="PREVIOUSINSTALLPATH" Secure="yes">
      <RegistrySearch Id="InstallPathSearch"
                      Root="HKCU"
                      Key="Software\MultiExplorer"
                      Name="InstallPath"
                      Type="raw" />
    </Property>

    <!--
      Use the previous installation directory as the default in both full-UI
      and silent installs. If no previous path is registered, INSTALLFOLDER
      retains its normal default under LocalAppDataFolder.
    -->
    <SetDirectory Id="INSTALLFOLDER"
                  Value="[PREVIOUSINSTALLPATH]"
                  Condition="PREVIOUSINSTALLPATH"
                  Sequence="both" />

    <MediaTemplate EmbedCab="yes" />

    <!-- App icon displayed in Add/Remove Programs -->
    <Icon Id="AppIcon" SourceFile="Assets\MultiExplorer-Installer.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- ── Install directory: %LocalAppData%\Programs\MultiExplorer ── -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MultiExplorer">

          <Component Id="MainExe" Guid="{802E9B3B-9AAA-41A8-AF21-CB895645D4C1}">
            <File Id="MultiExplorerExe"
                  Source="$(var.PublishDir)MultiExplorer.exe" />
            <File Id="LicenseFile"
                  Source="$(var.SourceDir)LICENSE.txt"
                  Name="LICENSE.txt" />
            <File Id="ReadmeFile"
                  Source="$(var.SourceDir)README.md"
                  Name="README.md" />
            <!--
              ICE38: per-user installs require an HKCU registry value as KeyPath.
              ICE64: user-profile directories must have RemoveFolder entries
                     (Windows Installer only removes them if empty at uninstall time).
            -->
            <!--
              Recursively delete everything under the install directory on uninstall.
              This covers any files not tracked by the MSI (e.g. from a failed upgrade
              that left orphaned files) and ensures the directory itself is removed.
              Falls back gracefully if PREVIOUSINSTALLPATH is empty (property not found).
            -->
            <util:RemoveFolderEx Id="RemoveInstallFolderEx" On="uninstall" Property="PREVIOUSINSTALLPATH" />
            <RemoveFolder Id="RemoveInstallFolder"    Directory="INSTALLFOLDER"    On="uninstall" />
            <RemoveFolder Id="RemoveLocalProgramsDir" Directory="LocalProgramsDir" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\MultiExplorer"
                           Name="InstallPath"
                           Type="string"
                           Value="[INSTALLFOLDER]"
                           KeyPath="yes" />
          </Component>

          <!-- Satellite-resource directories used by the self-contained runtime.
               Generate-PublishedFiles.ps1 validates this list while harvesting. -->
          <Directory Id="PublishedDir_cs" Name="cs" />
          <Directory Id="PublishedDir_de" Name="de" />
          <Directory Id="PublishedDir_es" Name="es" />
          <Directory Id="PublishedDir_fr" Name="fr" />
          <Directory Id="PublishedDir_it" Name="it" />
          <Directory Id="PublishedDir_ja" Name="ja" />
          <Directory Id="PublishedDir_ko" Name="ko" />
          <Directory Id="PublishedDir_pl" Name="pl" />
          <Directory Id="PublishedDir_pt_BR" Name="pt-BR" />
          <Directory Id="PublishedDir_ru" Name="ru" />
          <Directory Id="PublishedDir_tr" Name="tr" />
          <Directory Id="PublishedDir_zh_Hans" Name="zh-Hans" />
          <Directory Id="PublishedDir_zh_Hant" Name="zh-Hant" />

        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- ── Desktop shortcut ─────────────────────────────────────────── -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{7E1663C1-F591-4819-9EE9-D57CDD64609D}">
        <Shortcut Id="DesktopSC"
                  Name="MultiExplorer"
                  Description="Dual-pane file explorer"
                  Icon="AppIcon" IconIndex="0"
                  Target="[INSTALLFOLDER]MultiExplorer.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\MultiExplorer"
                       Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- ── Start Menu shortcut ──────────────────────────────────────── -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="MultiExplorer">
        <Component Id="StartMenuShortcut" Guid="{F454644F-1F8B-4629-8203-4443A1B3B1BF}">
          <Shortcut Id="StartMenuSC"
                    Name="MultiExplorer"
                    Description="Dual-pane file explorer"
                    Icon="AppIcon" IconIndex="0"
                    Target="[INSTALLFOLDER]MultiExplorer.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\MultiExplorer"
                         Name="StartMenuShortcut"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="MainExe" />
      <ComponentGroupRef Id="PublishedRuntimeFiles" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- ════════════════════════════════════════════════════════════════
         UI  —  WixUI_InstallDir dialog sequence:
           1. WelcomeDlg       — welcome + what will be installed
           2. InstallDirDlg    — destination folder (default per-user path)
           3. VerifyReadyDlg   — ready to install
           4. ProgressDlg      — progress (automatic)
           5. ExitDialog       — success/failure + optional launch checkbox
         ════════════════════════════════════════════════════════════════ -->

    <!-- RTF file shown in the LicenseAgreementDlg -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="Assets\InstallerBanner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Assets\InstallerDialog.bmp" />

    <!-- Tell InstallDirDlg which property holds the install path -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!--
      Exit dialog: set expectations for the initial cold start, then offer to
      launch MultiExplorer immediately with the checkbox checked by default.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="The first launch may take a little longer than usual while Windows prepares the application. Subsequent launches will be faster." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch MultiExplorer" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX"     Value="1" />

    <!--
      Launch through WiX's in-process ShellExecute helper. An EXE custom action
      makes Windows Installer create a separate custom-action process and can
      briefly display a console host even when the target itself is a WinExe.
      ShellExecute also starts the application in the interactive user's context.
    -->
    <Property Id="WixShellExecTarget" Value="[#MultiExplorerExe]" />
    <CustomActionRef Id="Wix4ShellExec_X86" />

    <UI>
      <!--
        WixUI_InstallDir in WiX v4 already includes LicenseAgreementDlg in its
        built-in dialog flow (Welcome → License → InstallDir → Verify → Exit).
        No navigation overrides needed — just provide WixUILicenseRtf above.

        Wire Finish button → native ShellExecute action when the checkbox is ticked.
        Condition attribute replaces WiX v3 inner text on <Publish>.
        "NOT Installed" confines the launch to fresh installs.
      -->
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="Wix4ShellExec_X86"
               Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- Load the built-in InstallDir dialog set from WixToolset.UI.wixext -->
    <ui:WixUI Id="WixUI_InstallDir" />

  </Package>
</Wix>
