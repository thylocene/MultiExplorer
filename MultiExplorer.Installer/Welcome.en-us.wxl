<?xml version="1.0" encoding="utf-8"?>
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="en-US">
  <!-- Override the stock welcome copy to make the exact package identifiable. -->
  <String Id="WelcomeDlgDescription"
          Value="Version $(var.Version)  |  Build date $(var.BuildDate)&#13;&#10;&#13;&#10;The Setup Wizard will install [ProductName] on your computer. Click Next to continue or Cancel to exit the Setup Wizard." />
  <!-- WixUI displays this dialog instead of WelcomeDlg when the product is installed. -->
  <String Id="MaintenanceWelcomeDlgDescription"
          Value="Version $(var.Version)  |  Build date $(var.BuildDate)&#13;&#10;&#13;&#10;The Setup Wizard lets you change, repair, or remove [ProductName]. Click Next to continue or Cancel to exit the Setup Wizard." />
</WixLocalization>
