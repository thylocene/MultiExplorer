    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" ShortName="ououxowm" Name="MultiExplorer">
        <Component Id="StartMenuShortcut" Guid="{F454644F-1F8B-4629-8203-4443A1B3B1BF}" Bitness="always32">
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" Directory="AppMenuFolder" />
          <Shortcut Id="StartMenuSC" Directory="AppMenuFolder" Description="Dual-pane file explorer" Icon="AppIcon" IconIndex="0" WorkingDirectory="INSTALLFOLDER" ShortName="g9zqrncj" Name="MultiExplorer" Target="[INSTALLFOLDER]MultiExplorer.exe" />
          <RegistryValue Id="reg90_A0wfY5jtZc6Y.90HT6CVayXY" Key="Software\MultiExplorer" Name="StartMenuShortcut" Root="HKCU" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <CustomTable Id="Wix4RemoveFolderEx">
      <Column Id="RemoveFolderEx" Description="Identifier for the WixRemoveFolderEx row in the package." PrimaryKey="yes" Width="72" Category="identifier" Modularize="Column" Type="string" />
      <Column Id="Component_" Description="Foreign key into the Component table used to determine install state" KeyTable="Component" KeyColumn="1" Width="72" Category="identifier" Modularize="Column" Type="string" />
      <Column Id="Property" Description="Name of Property that contains the root of the directory tree to remove." Width="72" Category="identifier" Modularize="Column" Type="string" />
      <Column Id="InstallMode" Description="1 == Remove only when the associated component is being installed (msiInstallStateLocal or msiInstallStateSource), 2 == Remove only when the associated component is being removed (msiInstallStateAbsent), 3 = Remove in either of the above cases." MaxValue="3" MinValue="1" Width="2" Type="int" />
      <Column Id="Condition" Description="Optional expression which skips the removing of folders." Nullable="yes" Width="0" Category="condition" Modularize="Condition" Type="string" />
      <Row>
        <Data Column="RemoveFolderEx" Value="RemoveInstallFolderEx" />
        <Data Column="Component_" Value="MainExe" />
        <Data Column="Property" Value="PREVIOUSINSTALLPATH" />
        <Data Column="InstallMode" Value="2" />
      </Row>
    </CustomTable>
    <Feature Id="Main" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="PublishedComponent_E3B0C44298FC1C149AFB" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Dialog Id="ErrorDlg" X="50" Y="50" Width="270" Height="105" ErrorDialog="yes" Title="[ProductName] Setup">
        <Control Id="ErrorText" Type="Text" X="48" Y="15" Width="205" Height="60" Text="Information text" NoPrefix="yes" TabSkip="no" />
        <Control Id="Y" Type="PushButton" X="100" Y="80" Width="56" Height="17" Text="&amp;Yes" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
        <Control Id="A" Type="PushButton" X="100" Y="80" Width="56" Height="17" Text="Cancel" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="100" Y="80" Width="56" Height="17" Text="Cancel" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="ErrorIcon" Type="Icon" X="15" Y="15" Width="24" Height="24" Text="WixUI_Ico_Info" Disabled="yes" FixedSize="yes" IconSize="32" ToolTip="Information icon" TabSkip="yes" />
        <Control Id="I" Type="PushButton" X="100" Y="80" Width="56" Height="17" Text="&amp;Ignore" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="100" Y="80" Width="56" Height="17" Text="&amp;No" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="100" Y="80" Width="56" Height="17" Text="OK" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="100" Y="80" Width="56" Height="17" Text="&amp;Retry" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
      </Dialog>
      <Dialog Id="ExistingVersionDlg" X="50" Y="50" Width="370" Height="270" Title="MultiExplorer Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" Disabled="yes" TabSkip="no" />
        <Control Id="Continue" Type="PushButton" X="212" Y="243" Width="80" Height="17" Text="Continue" TabSkip="no" Default="yes">
          <Publish Condition="NOT Installed" Event="NewDialog" Value="LicenseAgreementDlg" />
          <Publish Condition="Installed" Event="ReinstallMode" Value="amus" />
          <Publish Condition="Installed" Event="Reinstall" Value="All" />
          <Publish Condition="Installed" Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="20" Text="Choose whether to replace the existing installation." Transparent="yes" NoPrefix="yes" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Text="Existing version detected" Transparent="yes" NoPrefix="yes" TabSkip="yes" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
        <Control Id="ReplaceMessage" Type="Text" X="25" Y="75" Width="320" Height="70" Text="The installed version of MultiExplorer is the same as or older than this setup package. Continuing will replace the existing installation with this version. Your application settings will be preserved." Hidden="yes" NoPrefix="yes" ShowCondition="NOT NEWER_VERSION_DETECTED" TabSkip="yes" />
        <Control Id="NewerMessage" Type="Text" X="25" Y="75" Width="320" Height="70" Text="A newer version of MultiExplorer is installed. Continuing will replace it with the older version in this setup package. Your application settings will be preserved." Hidden="yes" NoPrefix="yes" ShowCondition="NEWER_VERSION_DETECTED" TabSkip="yes" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" Disabled="yes" TabSkip="yes" />
      </Dialog>
      <Dialog Id="LicenseAgreementDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" Disabled="yes" TabSkip="no" />
        <Control Id="LicenseAcceptedCheckBox" Type="CheckBox" X="20" Y="207" Width="330" Height="18" Text="I &amp;accept the terms in the License Agreement" Property="LicenseAccepted" CheckBoxValue="1" TabSkip="no" />
        <Control Id="Print" Type="PushButton" X="112" Y="243" Width="56" Height="17" Text="&amp;Print" TabSkip="no">
          <Publish Event="DoAction" Value="WixUIPrintEula_X86" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" TabSkip="no">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Next" EnableCondition="LicenseAccepted = &quot;1&quot;" DisableCondition="LicenseAccepted &lt;&gt; &quot;1&quot;" TabSkip="no" Default="yes">
          <Publish Condition="LicenseAccepted = &quot;1&quot;" Event="NewDialog" Value="InstallDirDlg" />
          <Publish Condition="1 OR CostingComplete = 1" Event="SpawnWaitDialog" Value="WaitForCostingDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
