    <Binary Id="Wix4UtilCA_X86" SourceFile="FILE NOT EXPORTED" />
    <Binary Id="WixUiCa_X86" SourceFile="FILE NOT EXPORTED" />
    <Binary Id="WixUI_Bmp_Banner" SourceFile="FILE NOT EXPORTED" />
    <Binary Id="WixUI_Ico_Exclam" SourceFile="FILE NOT EXPORTED" />
    <Binary Id="WixUI_Ico_Info" SourceFile="FILE NOT EXPORTED" />
    <Binary Id="WixUI_Bmp_Up" SourceFile="FILE NOT EXPORTED" />
    <Binary Id="WixUI_Bmp_New" SourceFile="FILE NOT EXPORTED" />
    <Binary Id="WixUI_Bmp_Dialog" SourceFile="FILE NOT EXPORTED" />
    <Media Id="1" EmbedCab="yes" Cabinet="cab1.cab" />
    <SummaryInformation Description="MultiExplorer dual-pane file explorer" />
    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallFinalize" />
    <AdminUISequence>
      <Show Dialog="FatalError" OnExit="error" />
      <Show Dialog="UserExit" OnExit="cancel" />
      <Show Dialog="ExitDialog" OnExit="success" />
    </AdminUISequence>
    <InstallUISequence>
      <Show Dialog="FatalError" OnExit="error" />
      <Show Dialog="UserExit" OnExit="cancel" />
      <Show Dialog="ExitDialog" OnExit="success" />
      <Show Dialog="PrepareDlg" Before="AppSearch" />
      <Custom Action="SetINSTALLFOLDER" Condition="PREVIOUSINSTALLPATH" After="CostFinalize" />
      <Show Dialog="ResumeDlg" Condition="Installed AND (RESUME OR Preselected)" Before="WelcomeDlg" />
      <Show Dialog="WelcomeDlg" Condition="NOT Installed OR PATCH" Before="MaintenanceWelcomeDlg" />
      <Show Dialog="MaintenanceWelcomeDlg" Condition="Installed AND NOT RESUME AND NOT Preselected AND NOT PATCH" Before="ProgressDlg" />
      <Show Dialog="ProgressDlg" Before="ExecuteAction" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="Wix4RemoveFoldersEx_X86" Before="CostInitialize" />
      <Custom Action="SetINSTALLFOLDER" Condition="PREVIOUSINSTALLPATH" After="CostFinalize" />
      <Custom Action="Wix4CloseApplications_X86" Condition="VersionNT &gt; 400" Before="InstallValidate" />
      <Custom Action="Wix4CheckRebootRequired_X86" Condition="NOT REMOVE~=&quot;ALL&quot; AND VersionNT &gt; 400" After="InstallFinalize" />
    </InstallExecuteSequence>
  </Package>
</Wix>