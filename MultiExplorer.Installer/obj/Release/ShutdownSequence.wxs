      <Dialog Id="ResumeDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Install" Type="PushButton" X="212" Y="243" Width="80" Height="17" Text="&amp;Install" Hidden="yes" ElevationShield="yes" ShowCondition="ALLUSERS" TabSkip="no">
          <Publish Condition="1 OR CostingComplete = 1" Event="SpawnWaitDialog" Value="WaitForCostingDlg" />
