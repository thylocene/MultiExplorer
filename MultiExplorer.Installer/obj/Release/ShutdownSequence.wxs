    <CustomTable Id="Wix4CloseApplication">
      <Column Id="CloseApplication" Description="Primary key, non-localized token in table." PrimaryKey="yes" Width="72" Category="identifier" Modularize="Column" Type="string" />
      <Column Id="Target" Description="Name of executable to ensure is closed." Localizable="yes" Width="0" Category="formatted" Modularize="Property" Type="string" />
      <Column Id="Description" Description="Description string displayed to user when executable is in use." Nullable="yes" Width="0" Category="formatted" Modularize="Property" Type="string" />
      <Column Id="Condition" Description="Optional expression which skips the closing." Nullable="yes" Width="0" Category="condition" Modularize="Condition" Type="string" />
      <Column Id="Attributes" Description="A 32-bit word that specifies the attribute flags to be applied." MaxValue="2147483647" MinValue="0" Width="4" Type="int" />
      <Column Id="Sequence" Description="Sequence to order the closings by." MaxValue="2147483647" MinValue="1" Nullable="yes" Width="4" Type="int" />
      <Column Id="Property" Description="Optional property that is set to the number of running instances of the app." Nullable="yes" Width="72" Category="identifier" Modularize="Column" Type="string" />
      <Column Id="TerminateExitCode" Description="Exit code to return from a terminated application." MaxValue="2147483647" MinValue="0" Nullable="yes" Width="4" Type="int" />
      <Column Id="Timeout" Description="Timeout in milliseconds before scheduling restart or terminating application." MaxValue="2147483647" MinValue="1" Nullable="yes" Width="4" Type="int" />
      <Row>
        <Data Column="CloseApplication" Value="CloseMultiExplorer" />
        <Data Column="Target" Value="MultiExplorer.exe" />
        <Data Column="Description" Value="MultiExplorer is still running. Click Ignore to let Setup close it, or close it yourself (after finishing or cancelling active file operations) and click Retry." />
        <Data Column="Attributes" Value="96" />
        <Data Column="TerminateExitCode" Value="0" />
        <Data Column="Timeout" Value="1000" />
      </Row>
      <Row>
        <Data Column="CloseApplication" Value="CloseOperationHost" />
        <Data Column="Target" Value="MultiExplorer.OperationHost.exe" />
        <Data Column="Description" Value="A MultiExplorer copy, move, or delete operation is still running. Let it finish or cancel it, then click Retry. Choosing Ignore will forcibly stop the operation." />
        <Data Column="Attributes" Value="96" />
        <Data Column="TerminateExitCode" Value="1" />
        <Data Column="Timeout" Value="5000" />
      </Row>
    </CustomTable>
